# ===== ClickHouse (official mcp-clickhouse server) =====
# Dev mode: embedded chDB (free, no account, no credits) — keeps ClickHouse in the live path.
# chDB runs in-process via the mcp-clickhouse `run_chdb_select_query` tool. We set
# CLICKHOUSE_ENABLED=false so the real-client `run_query` tool is NOT registered and
# the chDB tools register instead (see mcp_server.py registration logic).
# NOTE: CHDB_DATA_PATH must be a FILE path (a temp dir), NOT ':memory:' — the mcp-clickhouse
# wrapper needs a persistent session for DDL to survive across calls.
CHDB_ENABLED=true
CLICKHOUSE_ENABLED=false
CHDB_DATA_PATH=/tmp/agentic_cinema_chdb

# Prod mode: ClickHouse Cloud (flip these once credits/account are live).
# CLICKHOUSE_HOST=your-instance.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-password
# CLICKHOUSE_SECURE=true
# CLICKHOUSE_VERIFY=true
# CLICKHOUSE_DATABASE=default
# Allow the agent to INSERT the notes-matrix + conflict flags.
CLICKHOUSE_ALLOW_WRITE_ACCESS=true
# Destructive ops stay OFF (CREATE/INSERT only; no DROP/TRUNCATE).
CLICKHOUSE_ALLOW_DROP=false

# ===== Gemini / Google Cloud (rules: Google Cloud AI only) =====
# Use Google Cloud Express Mode API key OR a service-account JSON path.
GOOGLE_API_KEY=
# GCP_PROJECT=your-gcp-project
# GCP_LOCATION=us-central1

# ===== Web app =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Secret Manager / local override for the MCP bearer token (dev: disable auth).
CLICKHOUSE_MCP_AUTH_DISABLED=true
